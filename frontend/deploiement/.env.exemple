# =====================================================================
# Modèle du fichier .env du serveur (copier en .env et compléter).
# Ce fichier réel ne doit JAMAIS être versionné.
# =====================================================================
IMAGE=ghcr.io/VOTRE_ORGANISATION/plateforme-api
TAG=sha-0000000
DOMAINE_API=api.plateforme.bf

# Base de données (VPS 2) – connexion chiffrée
DB_URL=jdbc:postgresql://10.0.0.2:5432/plateforme?sslmode=require
DB_USER=app_plateforme
DB_PASSWORD=
FLYWAY_USER=plateforme_owner
FLYWAY_PASSWORD=

# Sécurité – générer avec : openssl rand -base64 48
JWT_SECRET=
JWT_EMETTEUR=https://api.plateforme.bf
ORIGINES_AUTORISEES=https://*.plateforme.bf
VERIFIER_SOUS_DOMAINE=false

# Premier super administrateur (supprimer ces lignes après la première connexion)
SUPER_ADMIN_TELEPHONE=
SUPER_ADMIN_MOT_DE_PASSE=
